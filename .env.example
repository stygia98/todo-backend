# todo-backend 환경변수 예시
#
# 이 파일은 키만 담고 값은 비워 커밋한다. 실제 값은 .env 에 넣으며 .env 는 커밋되지 않는다.
#
# ⚠️ Spring Boot 는 .env 파일을 자동으로 읽지 않는다.
#    .env 를 만들어 두는 것만으로는 기동에 실패하며, 아래 중 한 방법으로 실제 환경에 주입해야 한다.
#    자세한 방법은 CLAUDE.md 의 「로컬 실행 — 환경변수 공급」 절을 참조한다.

# --- 데이터베이스 ---
# 로컬 기본값은 application-local.yml 에 있으므로 비워 두어도 된다.
# postgres DB 에 ?currentSchema=... 로 붙지 않는다. todolist_db 데이터베이스에 직접 접속한다.
DB_URL=jdbc:postgresql://localhost:5432/todolist_db
DB_USERNAME=
DB_PASSWORD=

# --- JWT ---
# ⚠️ raw UTF-8 문자열 32자 이상을 그대로 키로 쓴다. Base64 로 디코드하지 않는다.
#    32자 문자열을 Base64 디코드하면 24바이트가 되어 HS256 이 요구하는 32바이트에 미달하고
#    기동 시 WeakKeyException 이 발생한다. 알고리즘(HS256)을 임의로 바꾸지 않는다.
JWT_SECRET=
# 24시간 (밀리초). 미지정 시 86400000 이 기본값이다.
JWT_EXPIRATION=86400000

# --- 구글 OAuth2 (Phase 5 에서 사용) ---
# Phase 5 이전에는 비워 두어도 된다. application.yml 에 registration 블록이 없으므로
# 값이 없어도 기동에 영향을 주지 않는다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 프론트엔드 연동 ---
# ⚠️ 아래 두 변수를 하나로 합치지 않는다. 요구하는 형식이 서로 다르다.
#
# FRONTEND_URL : 단일 URL. OAuth2 리다이렉트의 기준 주소다.
#                {FRONTEND_URL}/oauth/callback?token=xxx 형태로 조립되므로
#                쉼표 목록을 넣으면 깨진 주소로 302 를 보내게 된다.
FRONTEND_URL=http://localhost:3000
#
# CORS_ALLOWED_ORIGINS : 쉼표로 구분된 목록. CORS 허용 오리진 전용이다.
#                        운영에서는 Amplify 브랜치 도메인과 커스텀 도메인을 동시에 허용해야 한다.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- 첨부 이미지 저장 (Phase 12 부터, 로컬 스토리지) ---
# ⚠️ 기본값이 없다. 미설정 시 기동 자체가 실패한다(LocalStorageService).
#    문서 저장소(todo-project) 워킹트리 안에 두지 않는다 — 실수 커밋 위험이 있다.
# ⚠️ 역슬래시(\)가 아니라 슬래시(/)로 적는다. Git Bash 의 `source .env` 가 역슬래시를
#    이스케이프로 해석해 경로 구분자가 사라진다(예: D:\a\b → D:ab).
LOCAL_UPLOAD_DIR=
# 로컬 조회 URL(뷰 토큰 포함)의 기준 주소. 미지정 시 http://localhost:8080 이 기본값이다.
BACKEND_BASE_URL=http://localhost:8080
# 첨부 조회용 뷰 토큰의 만료 시간(밀리초). 미지정 시 86400000(24시간)이 기본값이다.
ATTACHMENT_URL_EXPIRATION=86400000

# --- 첨부 이미지 저장 — S3 (Phase 14부터) ---
# 로컬 프로파일(local)은 storage.type=local 고정이라 이 값들이 없어도 기동에 영향을 주지 않는다.
# prod 프로파일(app.storage.type=s3)로 로컬에서 검증할 때만 필요하다.
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
# ⚠️ EC2 운영 환경에는 이 두 값을 쓰지 않는다. IAM Role을 연결해 SDK가 자동으로
#    자격 증명을 얻게 한다(CLAUDE.md 6장 인증 설계 참조). 이 액세스 키는 로컬 개발 검증 전용이며,
#    IAM 사용자의 권한은 해당 버킷에 대한 PutObject/GetObject/DeleteObject/ListBucket으로 최소화한다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
