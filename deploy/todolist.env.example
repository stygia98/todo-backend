# TodoList Backend 운영 환경변수 템플릿 (값 없음, 커밋용)
# 실제 값을 채운 파일은 이 저장소에 절대 커밋하지 않는다.
# 채운 뒤 WinSCP로 EC2의 /etc/todolist/todolist.env 경로에 업로드한다.

# --- Database (RDS PostgreSQL) ---
# postgres 기본 DB가 아니라 todolist_db 데이터베이스 자체에 직접 접속한다.
DB_URL=jdbc:postgresql://your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:5432/todolist_db
DB_USERNAME=postgres
DB_PASSWORD=

# --- JWT ---
# raw UTF-8 32자 이상. Base64로 디코드하지 않는다 (CLAUDE.md 12장).
JWT_SECRET=
JWT_EXPIRATION=86400000

# --- OAuth2 (Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Frontend / CORS ---
# 프론트를 아직 배포하지 않았다면 localhost로 두고, 배포 후 갱신한다.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- 로컬 저장 폴백 (LocalStorageService, storage.type=s3 여도 항상 등록됨 — CLAUDE.md 4장) ---
LOCAL_UPLOAD_DIR=/home/ec2-user/uploads
BACKEND_BASE_URL=http://your-ec2-public-ip:8080

# --- AWS S3 ---
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
# EC2에 IAM Role이 연결되어 있으면 아래 두 값은 비워둔다 (DefaultCredentialsProvider가 IAM Role을 자동 사용).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
